# scripts/rebrand.py config (Vulnesis/ops).
# redirects/ serves only the retired Vulnetix doc hosts (they never existed on
# vulnes.is): it stays an exact Vulnetix copy, so a deploy from either repo is
# the same script with the same routes.
ignore redirects/*
# Redirect maps for the retired Vulnetix doc hosts: file names are those hosts (data).
ignore migration/*
# The redirects Worker is generated from those maps plus this host table; all
# three describe the retired Vulnetix hosts, so they stay together as data.
ignore scripts/lib/redirects.mjs
ignore redirects/worker.js
# Brand names inside JavaScript regular expressions (tests), which the display
# rule does not treat as strings.
rewrite (?:Vulnetix|Resolve) [Cc]onsole => (?:Vulnesis|Vulnetix|Resolve) [Cc]onsole
rewrite /^# Vulnetix documentation => /^# Vulnesis documentation
# Its tests exercise that retired-host data.
ignore test/migration.test.mjs
